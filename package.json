{
  "name": "ts-rest-to-orpc",
  "version": "0.1.0",
  "description": "Codemod that converts ts-rest contracts into oRPC contracts",
  "keywords": [
    "codemod",
    "ts-rest",
    "orpc",
    "migration",
    "contract",
    "openapi"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "ts-rest-to-orpc": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:fixtures": "tsx scripts/emit-typecheck-fixtures.ts && pnpm -r --filter \"./typecheck/*\" run typecheck",
    "prepublishOnly": "pnpm build && pnpm test && pnpm typecheck"
  },
  "dependencies": {
    "cac": "^7.1.0",
    "tinyglobby": "^0.2.17",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.23.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philipjlane/ts-rest-to-orpc.git"
  },
  "bugs": {
    "url": "https://github.com/philipjlane/ts-rest-to-orpc/issues"
  },
  "homepage": "https://github.com/philipjlane/ts-rest-to-orpc#readme",
  "author": "Philip Lane",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
